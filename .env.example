# ─────────────────────────────────────────────────────────────
#  Sunservice · Подбор авто — переменные окружения
#  Скопируйте в .env и заполните значения.
# ─────────────────────────────────────────────────────────────

# ── База данных (PostgreSQL) ────────────────────────────────
DATABASE_URL="postgresql://sunservice:sunservice@localhost:5432/sunservice?schema=public"

# ── Публичный адрес сайта (для canonical, OG, sitemap) ──────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Сессии админки ──────────────────────────────────────────
# Секрет для подписи cookie сессии. Обязателен в production.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# ── Первый администратор (используется скриптом seed / admin:create) ──
ADMIN_EMAIL="admin@sunservice-auto.ru"
ADMIN_PASSWORD=""
ADMIN_NAME="Администратор"

# ── Хранилище изображений ───────────────────────────────────
# local — файлы в public/uploads (по умолчанию, для разработки)
# s3    — любое S3-совместимое хранилище (Yandex Object Storage, MinIO, Cloudflare R2)
STORAGE_DRIVER="local"

# Заполняется только при STORAGE_DRIVER=s3
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Публичный базовый URL бакета (без слэша на конце).
# Если не задан — собирается как {S3_ENDPOINT}/{S3_BUCKET}
S3_PUBLIC_URL=""
# Хост для next/image remotePatterns (только домен, без протокола)
NEXT_PUBLIC_ASSET_HOST=""

# ── Отправка заявок во внешнюю систему (CRM) ────────────────
# Необязательно. Если задан — на каждую новую заявку уходит POST с JSON.
# Приоритет у значения из админки (Настройки → Интеграции), эта переменная — запасной вариант.
LEAD_WEBHOOK_URL=""
# Значение уходит в заголовке X-Webhook-Secret, если задано.
LEAD_WEBHOOK_SECRET=""
